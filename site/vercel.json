{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/((?!api/|api$|download|admin|276cd47d9ac6fadd42e9ec57005f1cc9\\.txt).*)",
      "has": [
        {
          "type": "host",
          "value": "keyware-app.vercel.app"
        }
      ],
      "destination": "https://keyware.site/$1",
      "permanent": true
    },
    {
      "source": "/download",
      "destination": "/download/Keyware.exe",
      "permanent": false
    },
    {
      "source": "/download/Keyware-Setup.exe",
      "destination": "/download/Keyware.exe",
      "permanent": false
    },
    {
      "source": "/docs",
      "destination": "/guide",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/((?!admin|api/admin).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'self'; img-src 'self' data:; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
        }
      ]
    },
    {
      "source": "/download/:version/Keyware.exe",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.microsoft.portable-executable"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Keyware.exe\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/download/:version/Keyware-arm64.exe",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.microsoft.portable-executable"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Keyware-arm64.exe\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(img|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(llms|llms-full|robots)\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "functions": {
    "api/bind.js": {
      "maxDuration": 25
    },
    "api/admin.js": {
      "maxDuration": 20
    },
    "api/download.js": {
      "maxDuration": 10
    },
    "api/release.js": {
      "maxDuration": 10
    },
    "api/feedback.js": {
      "maxDuration": 10
    },
    "api/kofi-webhook.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/download/Keyware.exe",
      "destination": "/api/download"
    },
    {
      "source": "/download/Keyware-arm64.exe",
      "destination": "/api/download?arch=arm64"
    },
    {
      "source": "/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/admin/login",
      "destination": "/api/admin?route=login"
    },
    {
      "source": "/admin/logout",
      "destination": "/api/admin?route=logout"
    },
    {
      "source": "/admin/feedback",
      "destination": "/api/admin?route=feedback"
    }
  ]
}
